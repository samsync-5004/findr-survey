rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /responses/{responseId} {
      allow create: if request.resource.data.keys().hasAll(['submittedAt', 'screening', 'desirability', 'willingnessToPay', 'advocacy', 'openEnded', 'scores']);
      allow read, update, delete: if request.auth != null;
    }
  }
}
